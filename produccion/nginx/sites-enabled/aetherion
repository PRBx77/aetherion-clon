server {
    listen 80 default_server;
    server_name _;
    root /opt/aetherion/frontend;
    index aetherion-public.html;

    # Scanner bot block
    location ~ \.(env|git|svn|htaccess|htpasswd|DS_Store)$ { access_log off; return 444; }
    location = /config.json { access_log off; return 444; }
    location = /composer.json { access_log off; return 444; }
    location = /package.json { access_log off; return 444; }
    location = /phpinfo.php { access_log off; return 444; }
    location ~ ^/(wp-admin|wp-login|wordpress|phpmyadmin|admin/config|owa) { access_log off; return 444; }
    location ~ ^/\.(env|git) { access_log off; return 444; }

    location /static/ {
        alias /opt/aetherion/backend/ai-service/static/;
        access_log off;
        expires 1h;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8100/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 90s;
    }

    location / {
        try_files $uri $uri/ /aetherion-public.html;
    }
}
